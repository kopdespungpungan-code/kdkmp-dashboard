# Salin file ini menjadi .env.local untuk lokal,
# atau isi sebagai Environment Variables di Vercel.

# ===== WAJIB =====
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Opsional (belum dipakai kode, untuk kompatibilitas key baru)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# ===== OPSIONAL: OCR nota & laporan =====
# Disarankan atur lewat menu Pengaturan di dashboard (butuh supabase/pengaturan.sql).
# Variabel di bawah adalah fallback bila pengaturan database kosong.
# Model default qwen/qwen3-vl-30b-a3b-instruct (OCR vision, value for money).
# Alternatif lebih murah: qwen/qwen3.7-flash atau inclusionai/ling-3.0-flash-vl.
# Daftar harga: https://openrouter.ai/models?modality=image
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# auto = tidak mengirim parameter reasoning (aman untuk model non-reasoning).
# off/on/low/medium/high/max = atur reasoning sesuai model.
OPENROUTER_OCR_REASONING=auto

# Endpoint alternatif yang kompatibel OpenAI (/chat/completions).
# Dipakai bila pengaturan database kosong dan OPENROUTER_API_KEY juga kosong.
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

# ===== OPSIONAL: fallback OCR laporan/absensi =====
# Dipakai hanya kalau Base URL/API key di menu Pengaturan kosong.
GEMINI_API_KEY=
