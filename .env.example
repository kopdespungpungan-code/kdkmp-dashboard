# Salin file ini menjadi .env.local untuk lokal,
# atau isi sebagai Environment Variables di Vercel.

# ===== WAJIB =====
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Opsional (belum dipakai kode, untuk kompatibilitas key baru)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# ===== OPSIONAL: OCR nota (menu Penjualan) =====
# Endpoint model yang kompatibel OpenAI (/chat/completions)
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

# ===== OPSIONAL: OCR laporan/absensi =====
# Isi salah satu. Dipakai src/app/api/ocr-laporan/route.ts
GEMINI_API_KEY=
OPENAI_API_KEY=
